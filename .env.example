# Copiez ce fichier en ".env" et remplissez vos vraies valeurs.
# Ne jamais commiter le fichier ".env" lui-meme (donnees sensibles).

# --- Django ---
SECRET_KEY=changez-moi-en-production-avec-une-cle-aleatoire-longue
DEBUG=True
ALLOWED_HOSTS=*

# --- Base de donnees ---
# Laissez vide pour utiliser SQLite en local (par defaut).
# En production, mettez l'URL fournie par votre hebergeur, ex:
# DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/nom_bdd
DATABASE_URL=

# --- Paiements CinetPay (agrege Orange Money + MTN MoMo) ---
# Creez un compte sur https://cinetpay.com puis recuperez ces cles
# dans Mon compte > Cles API. Utilisez le mode "test" pour les essais.
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_MODE=test

# --- Notifications WhatsApp (via Twilio) ---
# Creez un compte sur https://www.twilio.com, activez le WhatsApp Sandbox
# (gratuit pour tester), puis recuperez ces valeurs dans la console Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
